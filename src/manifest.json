{
  "manifest_version": 3,
  "name": "Mocknik — Fake Form Filler",
  "short_name": "Mocknik",
  "version": "0.1.1",
  "description": "Fill any web form with fake data in one click. Local-only, no network, with per-field rules for fixed values, templates, mirrors.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "contextMenus"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Fill form with fake data",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "commands": {
    "fill_all_inputs": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Fill all inputs"
    },
    "fill_this_form": {
      "suggested_key": { "default": "Alt+Shift+G" },
      "description": "Fill this form"
    },
    "fill_this_input": {
      "suggested_key": { "default": "Alt+Shift+H" },
      "description": "Fill this input"
    }
  }
}
